{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "taskmaster-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3123"
      ],
      "env": {
        "NEXT_PUBLIC_SUPABASE_URL": "",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": ""
      },
      "port": 3123
